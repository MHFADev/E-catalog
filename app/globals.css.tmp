@tailwind base;
@tailwind components;
@tailwind utilities;

:root {
  --color-glass-cherry: rgba(185, 28, 28, 0.12);
  --color-glass-cotton: rgba(245, 240, 232, 0.72);
  --color-glass-noir: rgba(24, 23, 23, 0.64);
}
html { scroll-behavior: smooth; -webkit-font-smoothing: antialiased; }
body { font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; color: #2D2D2D; background: #F5F0E8; }
a { color: inherit; text-decoration: none; }
button { font-family: inherit; cursor: pointer; }

.text-accent { color: #B91C1C; }
.btn-primary {
  display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
  padding: 0.75rem 1.5rem; font-weight: 500; border-radius: 9999px; border: none;
  background: linear-gradient(135deg, #B91C1C, #991B1B); color: white;
  cursor: pointer; transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}
.btn-primary:hover { transform: translateY(-2px) scale(1.02); background: linear-gradient(135deg, #DC2626, #B91C1C); }
.btn-secondary {
  display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
  padding: 0.75rem 1.5rem; font-weight: 500; border-radius: 9999px;
  background: white; color: #B91C1C; border: 1px solid #EDE4D3;
  cursor: pointer; transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}
.btn-secondary:hover { background: #F5F0E8; border-color: #E8DFC8; }

@keyframes cardEntrance {
  from { opacity: 0; transform: translateX(40px) scale(0.95); }
  to { opacity: 1; transform: translateX(0) scale(1); }
}